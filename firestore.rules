rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserCreate(data) {
      return data.keys().hasAll(['name', 'email', 'role', 'createdAt'])
        && data.keys().hasOnly([
          'name', 'email', 'role', 'gpa', 'attendance',
          'courses', 'enrolledCourseIds', 'schedule', 'tasks', 'createdAt'
        ])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 80
        && data.email is string && data.email.size() > 0 && data.email.size() <= 128
        && data.role == 'student';
    }

    function isValidCourse(data) {
      return data.keys().hasAll(['name', 'department', 'credits'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 120
        && data.department is string && data.department.size() > 0
        && data.credits is number && data.credits > 0 && data.credits <= 10
        && (!('prerequisites' in data) || (data.prerequisites is list && data.prerequisites.size() < 10));
    }

    function isValidEnrollment(data) {
      return data.keys().hasAll(['studentId', 'courseId', 'enrolledAt'])
        && data.studentId == request.auth.uid
        && data.courseId is string && data.courseId.size() > 0;
    }

    function isValidAdmission(data) {
      return data.keys().hasAll([
          'studentName', 'dob', 'gender', 'grade', 'medium',
          'parentName', 'phone', 'address', 'referenceId', 'createdAt'
        ])
        && data.studentName is string && data.studentName.size() > 0 && data.studentName.size() <= 100
        && data.grade is string && data.grade.size() > 0 && data.grade.size() <= 60
        && data.medium in ['Hindi Medium', 'English Medium']
        && data.parentName is string && data.parentName.size() > 0 && data.parentName.size() <= 100
        && data.phone is string && data.phone.size() >= 10 && data.phone.size() <= 18
        && data.address is string && data.address.size() > 0 && data.address.size() <= 400;
    }

    // 1. Users Collection (Supports initial 10-field profile creation + student course updates)
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && request.auth.uid == userId && isValidUserCreate(incoming());
      allow update: if isSignedIn() && (
        isAdmin() ||
        (
          request.auth.uid == userId
          && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'courses', 'enrolledCourseIds', 'tasks'])
          && incoming().role == existing().role
          && incoming().email == existing().email
          && incoming().createdAt == existing().createdAt
        )
      );
      allow delete: if isAdmin();
    }

    // 2. Public Online Admissions Collection (Anyone can submit a valid application; only Admin can view/manage)
    match /admissions/{applicationId} {
      allow create: if isValidAdmission(incoming());
      allow read, update, delete: if isAdmin();
    }

    // 3. Courses Collection
    match /courses/{courseId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidCourse(incoming());
      allow delete: if isAdmin();
    }

    // 4. Enrollments Collection
    match /enrollments/{enrollmentId} {
      allow get: if isSignedIn() && (existing().studentId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (existing().studentId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidEnrollment(incoming());
      allow update: if isAdmin() && incoming().enrolledAt == existing().enrolledAt;
      allow delete: if isSignedIn() && (existing().studentId == request.auth.uid || isAdmin());
    }
  }
}
